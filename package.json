{
  "name": "dsh-database-view",
  "version": "0.5.0",
  "description": "Database View for DeepSeek Harness: native Node.js drivers, SSH/TLS, inline table editing, no Java/JDBC.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-man97/dsh-database-view.git"
  },
  "homepage": "https://github.com/x-man97/dsh-database-view#readme",
  "bugs": {
    "url": "https://github.com/x-man97/dsh-database-view/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "drivers",
    "drivers.json",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/oracledb": "^26.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "mysql2": "^3.24.6",
    "oracledb": "^6.10.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tedious": "^20.3.9",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "dsh": ">=0.1.6-alpha.2",
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:drivers && npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "pretest": "npm run build:host",
    "test:completion": "vitest run tests/unit/completion- tests/unit/complete-smart.test.mjs tests/unit/console-complete",
    "qa:ui": "node scripts/qa-ui.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "changelog:check": "node scripts/build-changelog.mjs --check",
    "verify": "npm run typecheck && npm test",
    "build:drivers": "node scripts/build-drivers.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "database",
    "redis"
  ],
  "license": "MIT"
}
