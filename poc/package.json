{
  "name": "dsh-db-feasibility-poc",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal proofs for the DSH database preview feasibility study",
  "scripts": {
    "ssh": "ELECTRON_RUN_AS_NODE=1 \"$DSH_NODE_EXECUTABLE\" ssh-forward-poc.cjs",
    "mysql": "ELECTRON_RUN_AS_NODE=1 \"$DSH_NODE_EXECUTABLE\" mysql-tunnel-poc.cjs",
    "mysql-stream": "ELECTRON_RUN_AS_NODE=1 \"$DSH_NODE_EXECUTABLE\" mysql-stream-poc.cjs",
    "pg": "ELECTRON_RUN_AS_NODE=1 \"$DSH_NODE_EXECUTABLE\" pg-tunnel-poc.cjs",
    "seed-mysql": "ELECTRON_RUN_AS_NODE=1 \"$DSH_NODE_EXECUTABLE\" seed-mysql.cjs"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "ssh2": "^1.17.0"
  }
}
